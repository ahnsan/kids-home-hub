# Kids Home Hub - Environment Variables Example
# Copy this file to .env for local development

# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here

# KV Namespace IDs (get these from: wrangler kv:namespace list)
KV_NAMESPACE_ID=your_kv_namespace_id_here
KV_PREVIEW_ID=your_preview_kv_namespace_id_here

# Claude Flow Configuration (Optional)
CLAUDE_FLOW_ENABLED=true
HIVE_MEMORY_ENABLED=true
AGENT_SWARMS_ENABLED=true

# Analytics Configuration (Optional)
ANALYTICS_ENABLED=true
ANALYTICS_SCHEDULE=0 0 * * *  # Daily at midnight UTC

# Feature Flags
ENABLE_RECOMMENDATIONS=true
ENABLE_INSIGHTS_DASHBOARD=false  # Coming soon
ENABLE_VOICE_INTEGRATION=false   # Coming soon

# Development Settings
DEV_MODE=true
VERBOSE_LOGGING=false

# Child Configuration (Optional customization)
CHILD_1_NAME=Adam
CHILD_2_NAME=Sami

# Points & Rewards Configuration
POINT_TO_MINUTES_RATIO=1  # 1 point = 1 minute of screen time
MAX_DAILY_SCREEN_TIME=120  # Maximum minutes per day

# Currency Configuration
PRIMARY_CURRENCY=GBP
SECONDARY_CURRENCY=AUD
GBP_TO_AUD_RATE=0.56

# Notification Settings (Future feature)
NOTIFICATION_ENABLED=false
NOTIFICATION_EMAIL=parent@example.com

# Privacy & Retention
DATA_RETENTION_DAYS=90
ENABLE_DATA_EXPORT=true
ENABLE_DATA_DELETE=true

# Performance
ENABLE_EDGE_CACHING=true
CACHE_TTL=3600  # 1 hour

# Security
REQUIRE_PARENT_AUTH=false  # Future feature
SESSION_TIMEOUT=3600

# Monitoring
ENABLE_ERROR_REPORTING=true
ENABLE_PERFORMANCE_TRACKING=true
