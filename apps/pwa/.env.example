# Supabase Configuration
# Get these values from your Supabase project settings:
# https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# App URL (OPTIONAL - only needed if you want to override the default behavior)
#
# By default, the app automatically uses window.location.origin for redirects.
# This means magic links and OAuth will redirect to wherever the app is accessed from.
#
# Only set this if you need to force a specific redirect URL:
# VITE_APP_URL=https://your-production-domain.com
#
# For most cases, leave this empty:
VITE_APP_URL=

# Backend API URL (for backward compatibility during migration)
VITE_API_URL=https://kids-home-hub-api.karim-005.workers.dev
